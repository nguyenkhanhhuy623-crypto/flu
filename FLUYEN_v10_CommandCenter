local function fitMenuToViewport()
    local width, height = getMenuSize()
    mainFrame.Size = UDim2.fromOffset(width, height)
    shadowFrame.Size = UDim2.fromOffset(width + 24, height + 24)
    if sidebar and contentArea then
        local sideWidth = getSidebarWidth()
        sidebar.Size = UDim2.new(0, sideWidth, 1, -72)
        sidebar.Position = UDim2.new(0, 0, 0, 72)
        contentArea.Size = UDim2.new(1, -sideWidth, 1, -72)
        contentArea.Position = UDim2.new(0, sideWidth, 0, 72)
    end
    local compact = width < 500
    if statusPill then statusPill.Visible = not compact end
    for name, button in pairs(tabButtons) do
        local defText = name
        for _, def in ipairs(TabDefs) do
            if def.name == name then
                defText = compact and def.icon or (def.icon .. "  " .. T(name))
                break
            end
        end
        button.Text = defText
        button.TextXAlignment = compact and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
        button.TextSize = compact and 18 or 10
        local pad = button:FindFirstChild("TabPadding")
        if pad then pad.PaddingLeft = compact and UDim.new(0, 0) or UDim.new(0, 11) end
    end
end

