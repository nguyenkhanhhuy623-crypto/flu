    addCheckbox(p, "Kill Aura (NPC / Tool Assist)", "KillAura", function(v)
        killConn("KillAura")
        if v then
            setConn("KillAura", RunService.Heartbeat:Connect(function()
                if not States.KillAura then killConn("KillAura") return end
                local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if not localRoot then return end
                if tick() >= nextWorldScan then
                    nextWorldScan = tick() + 0.65
                    pcall(scanWorldTargets)
