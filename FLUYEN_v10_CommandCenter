    targetPad.Parent = targetBox
    Instance.new("UICorner", targetBox).CornerRadius = UDim.new(0, 7)
    targetBox.FocusLost:Connect(function()
        Values.TargetName = targetBox.Text
    end)

    local function genericLocalStrike(model)
        local humanoid = model and model:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return false end
        local targetPlayer = Players:GetPlayerFromCharacter(model)
        if targetPlayer then
            local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
            if tool and type(tool.Activate) == "function" then
                pcall(function() tool:Activate() end)
                return true
            end
            return false
        end
        -- Only touch NPCs that the current client can legitimately control; no remote guessing.
        if model:IsDescendantOf(Workspace) then
            pcall(function() humanoid.Health = 0 end)
            return humanoid.Health <= 0
        end
        return false
    end

    addSection(p, "TARGET ACTIONS")
    addButton(p, "Kill Target / NPC", function()
        local target = findPlayerByName(Values.TargetName)
        if target and target.Character then
            local activated = genericLocalStrike(target.Character)
            if activated then
                notify("Combat", "Equipped tool activated. Player damage remains game-specific.", 3)
            else
                notify("Combat", "Player damage is game-specific; NPC health can only be changed when locally controlled.", 3)
            end
        else
            notify("Combat", "Target not found. Enter a partial player name.", 2)
