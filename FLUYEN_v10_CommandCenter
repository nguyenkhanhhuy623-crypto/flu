local function selectTab(name)
    if not pages[name] then return end
    if name ~= "Settings" and not KeyAuthenticated then
        requestAccess()
        name = "Settings"
    end
    currentTab = name
    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
        if pageName == name then pcall(function() page.CanvasPosition = Vector2.new(0, 0) end) end
    end
    for btnName, btn in pairs(tabButtons) do
        local active = btnName == name
        local theme = getTheme()
        btn.BackgroundColor3 = active and theme.tabActive or theme.tabInactive
        btn.TextColor3 = active and theme.text or theme.textDim
        btn.Font = active and Enum.Font.GothamBold or Enum.Font.GothamMedium
        local stripe = btn:FindFirstChild("ActiveStripe")
        if stripe then stripe.Visible = active end
    end
    recalcPage(pages[name])
end
