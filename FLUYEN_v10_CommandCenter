    addSection(p, T("Fly"))
    addCheckbox(p, T("Fly"), "Fly", function(v)
        killConn("Fly")
        if v then
            setConn("Fly", RunService.Heartbeat:Connect(function()
                if not States.Fly then killConn("Fly") return end
                pcall(function()
                    local char = player.Character
                    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local activeCamera = Workspace.CurrentCamera or camera
                    if not humanoid or not hrp or not activeCamera then return end
                    local bodyV = hrp:FindFirstChild("FLUYEN_FlyBV")
                    if not bodyV then
                        bodyV = Instance.new("BodyVelocity")
                        bodyV.Name = "FLUYEN_FlyBV"
                        bodyV.MaxForce = Vector3.new(1000000, 1000000, 1000000)
                        bodyV.P = 10000
                        bodyV.Velocity = Vector3.zero
                        bodyV.Parent = hrp
                    end
                    local moveDir = humanoid.MoveDirection
                    if moveDir.Magnitude < 0.05 then
                        local look = activeCamera.CFrame.LookVector
                        local right = activeCamera.CFrame.RightVector
                        local flatLook = Vector3.new(look.X, 0, look.Z)
                        local flatRight = Vector3.new(right.X, 0, right.Z)
                        local keyboardDir = Vector3.zero
                        if UserInputService:IsKeyDown(Enum.KeyCode.W) then keyboardDir = keyboardDir + flatLook end
                        if UserInputService:IsKeyDown(Enum.KeyCode.S) then keyboardDir = keyboardDir - flatLook end
                        if UserInputService:IsKeyDown(Enum.KeyCode.A) then keyboardDir = keyboardDir - flatRight end
                        if UserInputService:IsKeyDown(Enum.KeyCode.D) then keyboardDir = keyboardDir + flatRight end
                        moveDir = keyboardDir
                    end
                    if moveDir.Magnitude > 1 then moveDir = moveDir.Unit end
                    local vertical = 0
                    if humanoid.Jump or UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical = vertical + 1 end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical = vertical - 1 end
                    bodyV.Velocity = moveDir * Values.FlySpeed + Vector3.new(0, vertical * Values.FlySpeed, 0)
                end)
            end))
        else
            pcall(function()
                local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                local bv = root and root:FindFirstChild("FLUYEN_FlyBV")
                if bv then bv:Destroy() end
            end)
        end
    end)
    addSlider(p, T("FlySpeed"), "FlySpeed", 10, 200)

    local noclipOriginals = {}
    local function restoreNoclip()
        for part, original in pairs(noclipOriginals) do
            pcall(function()
                if part and part.Parent then part.CanCollide = original end
