local function worldRoot(instance)
    if not instance then return nil end
    if instance:IsA("BasePart") then return instance end
    if instance:IsA("Model") or instance:IsA("Tool") or instance:IsA("Folder") then
        return (instance:IsA("Model") and instance.PrimaryPart)
            or instance:FindFirstChild("HumanoidRootPart")
            or instance:FindFirstChild("Head")
            or instance:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function isItemCandidate(instance)
    local name = string.lower(instance.Name or "")
    if instance:IsA("Tool") or instance:FindFirstChildWhichIsA("ProximityPrompt", true) then return true end
    return string.find(name, "item", 1, true) or string.find(name, "loot", 1, true)
        or string.find(name, "coin", 1, true) or string.find(name, "chest", 1, true)
        or string.find(name, "drop", 1, true) or string.find(name, "collect", 1, true)
        or string.find(name, "weapon", 1, true)
end

local function isMonsterCandidate(instance)
    if not instance:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(instance) then return false end
    local humanoid = instance:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health > 0
end

