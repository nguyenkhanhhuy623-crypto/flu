                local closest, closestDistance
                for _, data in ipairs(WorldTargets.monsters or {}) do
                    local root = data.root
                    local d = root and (root.Position - localRoot.Position).Magnitude
                    if d and d <= (Values.KillAuraRange or 25) and (not closestDistance or d < closestDistance) then closest, closestDistance = data.instance, d end
                end
                if closest then
                    genericLocalStrike(closest)
                else
                    local target = findPlayerByName(Values.TargetName)
