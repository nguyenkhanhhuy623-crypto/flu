local function updateEspLine(line, fromPoint, toPoint, color)
    local delta = toPoint - fromPoint
    local length = delta.Magnitude
    if length < 2 or length ~= length then
        line.Visible = false
        return
    end
    line.Position = UDim2.fromOffset(math.floor(fromPoint.X + 0.5), math.floor(fromPoint.Y + 0.5))
    line.Size = UDim2.fromOffset(math.max(2, math.floor(length + 0.5)), 2)
    line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    line.BackgroundColor3 = color
    line.BackgroundTransparency = 0.08
    line.Visible = true
end

