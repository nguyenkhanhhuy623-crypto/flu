local isOpen = false
local isAnimating = false
local menuToken = 0
local openTween = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local closeTween = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local function openMenu()
    if isOpen and not isAnimating then return end
    menuToken = menuToken + 1
    local token = menuToken
    isOpen = true
    isAnimating = true
    mainFrame.Visible = true
    shadowFrame.Visible = true
    backdrop.Visible = true
    backdrop.BackgroundTransparency = 1
    mainFrame.Position = UDim2.new(0.5, 0, 0.5, 9)
    shadowFrame.Position = UDim2.new(0.5, 0, 0.5, 17)
    uiScale.Scale = 0.94
    if miniBtn then miniBtn.Visible = false end
    if espLineGui then espLineGui.Enabled = false end
    recalcAllPages()
    TweenService:Create(backdrop, openTween, {BackgroundTransparency = 0.52}):Play()
    local move = TweenService:Create(mainFrame, openTween, {Position = UDim2.new(0.5, 0, 0.5, 0)})
    local shadowMove = TweenService:Create(shadowFrame, openTween, {Position = UDim2.new(0.5, 0, 0.5, 8)})
    move:Play()
    shadowMove:Play()
    TweenService:Create(uiScale, openTween, {Scale = 1}):Play()
    move.Completed:Connect(function()
        if token == menuToken then
            isAnimating = false
            mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
            shadowFrame.Position = UDim2.new(0.5, 0, 0.5, 8)
            uiScale.Scale = 1
        end
    end)
end
local function closeMenu()
    if not isOpen or isAnimating then return end
    menuToken = menuToken + 1
    local token = menuToken
    isOpen = false
    isAnimating = true
    if espLineGui then espLineGui.Enabled = false end
    local move = TweenService:Create(mainFrame, closeTween, {Position = UDim2.new(0.5, 0, 0.5, 9)})
    local shadowMove = TweenService:Create(shadowFrame, closeTween, {Position = UDim2.new(0.5, 0, 0.5, 17)})
    TweenService:Create(backdrop, closeTween, {BackgroundTransparency = 1}):Play()
    move:Play()
    shadowMove:Play()
    TweenService:Create(uiScale, closeTween, {Scale = 0.94}):Play()
    move.Completed:Connect(function()
        if token ~= menuToken or isOpen then return end
        isAnimating = false
        mainFrame.Visible = false
        shadowFrame.Visible = false
        backdrop.Visible = false
        mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
        shadowFrame.Position = UDim2.new(0.5, 0, 0.5, 8)
        uiScale.Scale = 1
        if States.MinimizeButton and miniBtn then miniBtn.Visible = true end
    end)
end
local function toggleMenu()
    if isOpen then closeMenu() else openMenu() end
end

