    track:SetAttribute("FLUYENRole", "toggleTrack")
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 10)
    local dot = Instance.new("Frame")
    dot.Name = "ToggleDot"
    dot.Size = UDim2.new(0, 16, 0, 16)
    dot.BackgroundColor3 = getTheme().textDim
    dot.BorderSizePixel = 0
    dot.ZIndex = 9
    dot.Parent = track
    dot:SetAttribute("FLUYENRole", "toggleDot")
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 8)
    local function sync(value)
        dot.Position = value and UDim2.new(1, -18, 0, 2) or UDim2.new(0, 2, 0, 2)
        dot.BackgroundColor3 = value and getTheme().accent or getTheme().textDim
        track.BackgroundColor3 = value and getTheme().accentDark or getTheme().checkboxBg
    end
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 10
    btn.Parent = row
    CheckboxRefs[#CheckboxRefs + 1] = {stateKey = stateKey, checkmark = dot, track = track, sync = sync}
    if stateKey ~= nil then StateCallbacks[stateKey] = callback end
    sync(stateKey ~= nil and States[stateKey] or false)
    btn.Activated:Connect(function()
        if requiresKey and not KeyAuthenticated then requestAccess() return end
        if stateKey == nil then return end
        States[stateKey] = not States[stateKey]
        sync(States[stateKey])
        if callback then pcall(function() callback(States[stateKey]) end) end
    end)
    return row
end

local function addSlider(page, text, valueKey, min, max, callback)
    local requiresKey = page.Name ~= "Page_Settings"
    local row = makeCard(page, 48)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.72, 0, 0, 18)
    label.Position = UDim2.new(0, 14, 0, 5)
    label.BackgroundTransparency = 1
    label.Text = text
    registerText(label, text)
    label.TextColor3 = getTheme().text
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 8
    label.Parent = row
    label:SetAttribute("FLUYENRole", "text")
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.25, 0, 0, 18)
    valueLabel.Position = UDim2.new(0.73, 0, 0, 5)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(Values[valueKey] or min)
    valueLabel.TextColor3 = getTheme().accent
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 11
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.ZIndex = 8
    valueLabel.Parent = row
    valueLabel:SetAttribute("FLUYENRole", "accentText")
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -28, 0, 5)
    track.Position = UDim2.new(0, 14, 1, -12)
    track.BackgroundColor3 = getTheme().sliderTrack
    track.BorderSizePixel = 0
    track.ZIndex = 8
    track.Parent = row
    track:SetAttribute("FLUYENRole", "track")
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 3)
    local fill = Instance.new("Frame")
    local current = tonumber(Values[valueKey]) or min
    local pct = math.clamp((current - min) / math.max(max - min, 1), 0, 1)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = getTheme().sliderFill
    fill.BorderSizePixel = 0
    fill.ZIndex = 9
    fill.Parent = track
    fill:SetAttribute("FLUYENRole", "accent")
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)
    local sliderBtn = Instance.new("TextButton")
    sliderBtn.Size = UDim2.new(1, 0, 0, 22)
    sliderBtn.Position = UDim2.new(0, 0, 1, -21)
    sliderBtn.BackgroundTransparency = 1
    sliderBtn.Text = ""
    sliderBtn.ZIndex = 10
    sliderBtn.Parent = row
    local dragging = false
    local function updateFromInput(input)
        local relX = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        local val = math.floor(min + relX * (max - min) + 0.5)
        Values[valueKey] = val
        fill.Size = UDim2.new(relX, 0, 1, 0)
        valueLabel.Text = tostring(val)
        if callback then pcall(function() callback(val) end) end
    end
    sliderBtn.InputBegan:Connect(function(input)
        if requiresKey and not KeyAuthenticated then requestAccess() return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    return row
end

