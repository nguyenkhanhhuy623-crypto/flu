local nextWorldScan = 0
local function scanWorldTargets()
    local monsters, items = {}, {}
    local count = 0
    for _, instance in ipairs(Workspace:GetDescendants()) do
        if count >= 350 then break end
        if isMonsterCandidate(instance) then
            local root = worldRoot(instance)
            if root then monsters[#monsters + 1] = {instance = instance, root = root} count = count + 1 end
        elseif (instance:IsA("Model") or instance:IsA("Tool") or instance:IsA("BasePart")) and isItemCandidate(instance) and not Players:GetPlayerFromCharacter(instance) then
            local root = worldRoot(instance)
            if root then items[#items + 1] = {instance = instance, root = root} count = count + 1 end
        end
    end
    WorldTargets = {monsters = monsters, items = items}
end

local function updateWorldEsp(activeCamera, localRoot)
    if not States.MonsterESP and not States.ItemESP then
        clearWorldVisuals()
        return
    end
    if tick() >= nextWorldScan then
            nextWorldScan = tick() + 0.65
        pcall(scanWorldTargets)
    end
    local seen = {}
    local maxDistance = math.max(50, tonumber(Values.WorldESPRange) or 300)
    local function draw(list, enabled, kind)
        if not enabled then return end
        for _, data in ipairs(list) do
            local root = data.root
            if root and root.Parent then
                local distance = localRoot and (root.Position - localRoot.Position).Magnitude or 0
                local screenPos, onScreen = activeCamera:WorldToViewportPoint(root.Position)
                if distance <= maxDistance and onScreen and screenPos.Z > 0 then
                    makeWorldVisual(data.instance, kind, root, distance)
                    seen[data.instance] = true
                end
            end
        end
    end
    draw(WorldTargets.monsters, States.MonsterESP, "Monster")
    draw(WorldTargets.items, States.ItemESP, "Item")
    for instance, entry in pairs(worldVisuals) do
        if not seen[instance] then
            pcall(function() if entry.gui then entry.gui.Enabled = false end end)
            pcall(function() if entry.highlight then entry.highlight.Enabled = false end end)
        end
    end
end

local function updateVisualRuntime()
    killConn("VisualRuntime")
    clearVisualObjects()
    local active = States.ESP or States.BoxESP or States.NameESP or States.HealthESP or States.DistanceESP or States.Tracers or States.MonsterESP or States.ItemESP or States.Chams
    if not active then
        espLineGui.Enabled = false
        return
    end
    setConn("VisualRuntime", RunService.RenderStepped:Connect(function()
        if not (States.ESP or States.BoxESP or States.NameESP or States.HealthESP or States.DistanceESP or States.Tracers or States.MonsterESP or States.ItemESP or States.Chams) then
            clearVisualObjects()
            espLineGui.Enabled = false
            killConn("VisualRuntime")
            return
        end
        pcall(function()
            local activeCamera = Workspace.CurrentCamera or camera
            local localRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if not activeCamera then return end
            local viewport = activeCamera.ViewportSize
            local theme = getTheme()
            local seenLines = {}
            local visibleTargets = {}
            hideEspLines()

            for _, targetPlayer in ipairs(Players:GetPlayers()) do
                local character = targetPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local head = character and character:FindFirstChild("Head")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if targetPlayer ~= player and character and root and humanoid and humanoid.Health > 0 then
                    local screenPos, inViewport = activeCamera:WorldToViewportPoint(root.Position)
                    local validScreen = inViewport and screenPos.Z > 0
                        and screenPos.X >= 4 and screenPos.X <= viewport.X - 4
                        and screenPos.Y >= 4 and screenPos.Y <= viewport.Y - 4

                    if States.ESP and validScreen then
                        local highlight = character:FindFirstChild("FLUYEN_ESP")
                        if not highlight then
                            highlight = Instance.new("Highlight")
                            highlight.Name = "FLUYEN_ESP"
                            highlight.FillTransparency = 0.62
                            highlight.OutlineTransparency = 0.05
                            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            highlight.Parent = character
                        end
                        highlight.FillColor = theme.accent
                        highlight.OutlineColor = theme.text
                    else
                        removeVisualObject(character, "FLUYEN_ESP")
                    end

                    if States.BoxESP and validScreen then
                        local box = character:FindFirstChild("FLUYEN_Box")
                        if not box then
                            box = Instance.new("BoxHandleAdornment")
                            box.Name = "FLUYEN_Box"
                            box.Adornee = root
                            box.Size = Vector3.new(4, 5, 1)
                            box.Transparency = 0.72
                            box.AlwaysOnTop = true
                            box.ZIndex = 5
                            box.Parent = character
                        end
                        box.Color3 = theme.accent
                    else
                        removeVisualObject(character, "FLUYEN_Box")
                    end

                    if head then
                        if States.NameESP then ensureNameGui(head, targetPlayer) else removeVisualObject(head, "FLUYEN_Name") end
                        if States.HealthESP then ensureHealthGui(head, humanoid) else removeVisualObject(head, "FLUYEN_Health") end
                        if States.DistanceESP and localRoot then
                            ensureDistanceGui(head, (root.Position - localRoot.Position).Magnitude)
                        else
                            removeVisualObject(head, "FLUYEN_Dist")
                        end
                    end

                    if States.Chams then
                        local cham = character:FindFirstChild("FLUYEN_Cham")
                        if not cham then
                            cham = Instance.new("Highlight")
                            cham.Name = "FLUYEN_Cham"
                            cham.FillTransparency = 0.42
                            cham.OutlineTransparency = 0.1
                            cham.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            cham.Parent = character
                        end
                        cham.FillColor = theme.accentDark
                        cham.OutlineColor = theme.accent
                    else
                        removeVisualObject(character, "FLUYEN_Cham")
                    end

                    if States.Tracers and validScreen then
                        local distance = localRoot and (root.Position - localRoot.Position).Magnitude or 0
                        table.insert(visibleTargets, {
                            key = tostring(targetPlayer.UserId),
                            point = Vector2.new(screenPos.X, screenPos.Y),
                            distance = distance,
                        })
                    end
                end
            end

            updateWorldEsp(activeCamera, localRoot)
            table.sort(visibleTargets, function(a, b) return a.distance < b.distance end)
            for index, data in ipairs(visibleTargets) do
                if index > MAX_VISIBLE_TRACERS then break end
                seenLines[data.key] = true
                local line = espLines[data.key]
                if not line then
                    line = Instance.new("Frame")
                    line.Name = "ESPLine_" .. data.key
                    line.AnchorPoint = Vector2.new(0, 0.5)
                    line.BorderSizePixel = 0
                    line.Active = false
                    line.ZIndex = 2
                    line.Parent = espLineGui
                    Instance.new("UICorner", line).CornerRadius = UDim.new(0, 1)
                    espLines[data.key] = line
                end
                local edgeX = math.clamp(data.point.X, 10, math.max(10, viewport.X - 10))
                local edgePoint = Vector2.new(edgeX, math.max(10, viewport.Y - 12))
                updateEspLine(line, edgePoint, data.point, theme.accent)
            end

            for key, line in pairs(espLines) do
                if not seenLines[key] then line.Visible = false end
            end
            espLineGui.Enabled = States.Tracers and not mainFrame.Visible and next(seenLines) ~= nil
        end)
    end))
end

