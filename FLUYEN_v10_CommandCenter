            if settings and settings.states and settings.states.AutoLoadSettings then
                if settings.theme then currentTheme = settings.theme end
                if settings.language then currentLang = settings.language end
                if settings.values then
                    for k, v in pairs(settings.values) do
                        if k == "AimSmoothness" and tonumber(v) and tonumber(v) < 1 then v = tonumber(v) * 100 end
                        Values[k] = v
                    end
                end
                if settings.states then
                    for k, v in pairs(settings.states) do States[k] = v end
                end
                refreshCheckboxes()
                pcall(applyTheme)
                pcall(applyLanguage)
                if KeyAuthenticated then pcall(replayActiveStateCallbacks) end
                notify("Auto Load", "Settings loaded. Enter key to unlock modules.", 2)
            end
        end)
    end
end)

