do
    local p = pages["Combat"]
    local aimTarget = nil
    local aimNextUpdate = 0
    local silentHookAttempted = false
    local silentHookReady = false

    local aimCircle = Instance.new("Frame")
    aimCircle.Name = "FLUYEN_AimFOV"
    aimCircle.AnchorPoint = Vector2.new(0.5, 0.5)
    aimCircle.BackgroundTransparency = 1
    aimCircle.BorderSizePixel = 0
    aimCircle.Visible = false
    aimCircle.ZIndex = 2
    aimCircle.Parent = screenGui
    Instance.new("UICorner", aimCircle).CornerRadius = UDim.new(1, 0)
    local aimCircleStroke = Instance.new("UIStroke")
    aimCircleStroke.Thickness = 1
    aimCircleStroke.Transparency = 0.25
    aimCircleStroke.Color = getTheme().accent
    aimCircleStroke.Parent = aimCircle

    local function getAimPart(targetPlayer)
        if not targetPlayer or not targetPlayer.Character then return nil end
        return targetPlayer.Character:FindFirstChild("Head")
            or targetPlayer.Character:FindFirstChild("UpperTorso")
            or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    end

    local function isAimTargetVisible(part)
        if not part or not camera then return false end
        local origin = camera.CFrame.Position
        local direction = part.Position - origin
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {player.Character}
        local result = Workspace:Raycast(origin, direction, params)
        return not result or result.Instance:IsDescendantOf(part.Parent)
    end

    local function getAimTarget()
        if not camera then return nil end
        local viewport = camera.ViewportSize
        local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
        local limit = States.AimFOV and math.max(20, Values.AimFOVValue) or math.huge
        local best, bestDistance = nil, limit
        for _, targetPlayer in ipairs(Players:GetPlayers()) do
            if targetPlayer ~= player and targetPlayer.Character then
                local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                local part = getAimPart(targetPlayer)
                if humanoid and humanoid.Health > 0 and part then
                    local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen and screenPos.Z > 0 then
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if distance <= bestDistance and isAimTargetVisible(part) then
                            bestDistance = distance
                            best = {player = targetPlayer, part = part}
                        end
                    end
                end
            end
        end
        return best
    end

    local function getAimPosition(target)
        if not target or not target.part then return nil end
        local position = target.part.Position
        if States.AimPrediction and target.player.Character then
            local root = target.player.Character:FindFirstChild("HumanoidRootPart")
            if root then position = position + root.AssemblyLinearVelocity * 0.12 end
        end
        return position
    end

    local function updateAimCircle()
        if not camera then return end
        local viewport = camera.ViewportSize
        local diameter = math.max(40, (Values.AimFOVValue or 90) * 2)
        aimCircle.Size = UDim2.fromOffset(diameter, diameter)
        aimCircle.Position = UDim2.fromOffset(viewport.X * 0.5, viewport.Y * 0.5)
        aimCircleStroke.Color = getTheme().accent
        aimCircle.Visible = States.AimFOV and not mainFrame.Visible
    end

    local function installSilentAimFallback()
        if silentHookAttempted then return end
        silentHookAttempted = true
        if type(hookmetamethod) ~= "function" then return end
        local mouse = player:GetMouse()
        local oldIndex
        local wrapper = function(self, key)
            if States.SilentAim and self == mouse and (key == "Hit" or key == "Target") then
                local target = aimTarget or getAimTarget()
                local position = getAimPosition(target)
                if target and position then
                    if key == "Hit" then return CFrame.new(position) end
                    return target.part
                end
            end
            return oldIndex(self, key)
        end
        local closure = wrapper
        if type(newcclosure) == "function" then closure = newcclosure(wrapper) end
        local ok, previous = pcall(function()
            return hookmetamethod(game, "__index", closure)
        end)
        if ok and previous then
            oldIndex = previous
            silentHookReady = true
        end
    end

    local function publishSilentTarget()
        local env = nil
        pcall(function() env = getgenv and getgenv() or _G end)
        if not env then return end
        env.FLUYEN_SilentTarget = aimTarget and aimTarget.part or nil
        env.FLUYEN_SilentPosition = getAimPosition(aimTarget)
        env.FLUYEN_SilentAimReady = silentHookReady
    end

    local function updateAimRuntime()
        killConn("AimRuntime")
        if not States.Aim and not States.SilentAim and not States.AimFOV then
            aimTarget = nil
            aimCircle.Visible = false
            publishSilentTarget()
            return
        end
        if States.SilentAim then installSilentAimFallback() end
        setConn("AimRuntime", RunService.RenderStepped:Connect(function()
            if tick() < aimNextUpdate then return end
            aimNextUpdate = tick() + 0.025
            aimTarget = getAimTarget()
            updateAimCircle()
            publishSilentTarget()
            if States.Aim and aimTarget then
                local position = getAimPosition(aimTarget)
                if position and camera then
                    local desired = CFrame.new(camera.CFrame.Position, position)
                    local smooth = math.clamp((Values.AimSmoothness or 50) / 100, 0.05, 1)
                    camera.CFrame = camera.CFrame:Lerp(desired, smooth)
                end
            end
        end))
    end

    local function findPlayerByName(query)
        query = string.lower(tostring(query or ""))
        if query == "" then return nil end
        for _, candidate in ipairs(Players:GetPlayers()) do
            if candidate ~= player then
                local full = string.lower(candidate.Name .. " " .. candidate.DisplayName)
                if string.find(full, query, 1, true) then return candidate end
            end
        end
        return nil
    end

    local targetCard = makeCard(p, 44)
    local targetBox = Instance.new("TextBox")
    targetBox.Size = UDim2.new(1, -28, 0, 30)
    targetBox.Position = UDim2.new(0, 14, 0, 7)
